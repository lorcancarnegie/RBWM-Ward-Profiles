)
# ---- 2) Split multiple entries, extract clade & subtype ----
tidy <- raw %>%
mutate(genetic_clade = str_replace_all(genetic_clade, "\\s*;\\s*", ";")) %>%
separate_rows(genetic_clade, sep = ";") %>%
mutate(
clade   = str_trim(str_remove(genetic_clade, "\\s*\\(.*\\)$")),
subtype = str_match(genetic_clade, "\\(([^)]+)\\)")[,2]
) %>%
select(country, clade, subtype) %>%
distinct()
# ---- 3) Normalise country names ----
norm_country <- function(x){
x %>%
str_replace("^Ireland, Republic of$", "Ireland") %>%
str_replace("^Moldova, Republic of$", "Moldova") %>%
str_replace("^Korea, Republic of$", "South Korea") %>%
str_replace("^Russian Federation$", "Russia") %>%
str_replace("^United States of America \\(the\\)$", "United States") %>%
str_replace("^United Kingdom of Great Britain and Northern Ireland \\(the\\)$", "United Kingdom") %>%
str_replace("^Taiwan, China$", "Taiwan") %>%
str_replace("^Viet Nam$", "Vietnam")
}
tidy <- tidy %>%
mutate(country_norm = norm_country(country),
iso3c = countrycode(country_norm, "country.name", "iso3c"))
tidy <- tidy %>%
mutate(iso3c = ifelse(country == "Svalbard and Jan Mayen Islands", "SJM", iso3c),
iso3c_map = ifelse(iso3c == "SJM", "NOR", iso3c))
# ---- 4) World map and centroids ----
world <- ne_countries(scale = "medium", returnclass = "sf")
robin <- st_crs("+proj=robin +lon_0=0 +datum=WGS84")
world_pts <- world %>%
st_transform(robin) %>%
select(iso_a3, geometry) %>%
mutate(centroid = st_point_on_surface(geometry)) %>%
st_transform(4326) %>%
select(iso_a3, centroid)
plot_df <- tidy %>%
inner_join(world_pts, by = c("iso3c_map" = "iso_a3")) %>%
st_as_sf() %>%
st_set_geometry("centroid")
# ---- 5) Factor levels ----
plot_df <- plot_df %>%
mutate(
clade = factor(clade,
levels = c("2.3.4.4b","2.3.2.1a","2.3.2.1e","2.3.2.1g","unknown")),
subtype = factor(subtype,
levels = c("H5N1","H5N5","H5N2","H5N8","H5N9","H5","HPAI"))
)
# ---- 6) Plot ----
ggplot() +
geom_sf(data = world, fill = "grey95", color = "grey80", linewidth = 0.2) +
geom_sf(
data = plot_df,
aes(geometry = centroid, colour = clade, shape = subtype),
size = 2.8, alpha = 0.9
) +
coord_sf(crs = robin) +
guides(colour = guide_legend(title = "Genetic clade"),
shape  = guide_legend(title = "Subtype")) +
labs(
title = "Global detections of H5 viruses by genetic clade and subtype",
subtitle = "Each point at country centroid; multiple points if multiple clade–subtype combinations",
caption = "Data: user-provided list"
) +
theme_minimal(base_size = 12) +
theme(panel.grid = element_line(linewidth = 0.2, colour = "grey90"),
legend.position = "bottom", legend.box = "vertical",
plot.title = element_text(face = "bold"))
